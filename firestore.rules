rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create, update: if owner(uid);
      // Account removal is an authenticated server operation; no orphaned subcollections.
      allow delete: if false;
      match /{collection}/{id} {
        allow read, write: if owner(uid) && collection in [
          'tasks', 'timetable', 'transactions', 'wallets', 'categoryBudgets',
          'loans', 'subscriptions', 'billSplits', 'sleep', 'workouts', 'meals',
          'bodyMetrics', 'healthSettings', 'mealPlans', 'workoutSessions',
          'notificationSettings', 'pushSubscriptions'
        ];
      }
    }
    // Mail receipts, reset tokens, counters and admin settings are server-only.
  }
}
