{
  "framework": "vite",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{server/**,src/assistant/**,src/utils/**}",
      "maxDuration": 60
    },
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,dist/**,tests/**,.git/**}"
    }
  }
}
