{
  "framework": "vite",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{server/**,src/assistant/**,src/utils/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/reminder-emails",
      "schedule": "0 8 * * *"
    }
  ]
}
